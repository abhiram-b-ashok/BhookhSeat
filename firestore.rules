rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // A new booking must have exactly these fields, with sensible values.
    // Keep this list in step with BOOKING_DOCUMENT_KEYS (a test checks it).
    function isValidNewBooking(userId, bookingId) {
      let b = request.resource.data;
      return b.keys().hasOnly([
          'id', 'userId', 'restaurantId', 'restaurantName', 'durationMinutes',
          'cancellationAllowed', 'date', 'time', 'guestCount', 'tableType',
          'tableLabel', 'status', 'createdAt'
        ])
        && b.keys().hasAll([
          'id', 'userId', 'restaurantId', 'restaurantName', 'durationMinutes',
          'cancellationAllowed', 'date', 'time', 'guestCount', 'tableType',
          'tableLabel', 'status', 'createdAt'
        ])
        && b.id == bookingId
        && b.userId == userId
        && b.status == 'confirmed'
        && b.restaurantId is string && b.restaurantId.size() > 0 && b.restaurantId.size() <= 64
        && b.restaurantName is string && b.restaurantName.size() <= 100
        && b.tableLabel is string && b.tableLabel.size() <= 60
        && b.durationMinutes is number && b.durationMinutes > 0 && b.durationMinutes <= 480
        && b.cancellationAllowed is bool
        && b.date is string && b.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && b.time is string && b.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && b.guestCount is number && b.guestCount >= 1 && b.guestCount <= 12
        && b.tableType in ['couple', 'standard', 'family', 'large_group']
        && b.createdAt is string && b.createdAt.size() <= 40;
    }

    // Shared table counts. The document id must match its contents.
    // Keep this list in step with OCCUPANCY_DOCUMENT_KEYS (a test checks it).
    function isValidOccupancy(docId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['restaurantId', 'date', 'counts'])
        && d.keys().hasAll(['restaurantId', 'date', 'counts'])
        && d.restaurantId is string
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && docId == d.restaurantId + '_' + d.date
        && d.counts is map;
    }

    // Each person's bookings: only the owner can see them. Bookings are never deleted,
    // and the only allowed change is confirmed -> cancelled.
    match /users/{userId}/bookings/{bookingId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidNewBooking(userId, bookingId);
      allow update: if isOwner(userId)
        && resource.data.status == 'confirmed'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // Shared counts: any signed-in user can read them and update them with a valid shape.
    // Limit: rules cannot check that a count change matches a booking, so a modified app
    // could write wrong counts. Closing that needs a server (Cloud Functions).
    match /occupancy/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidOccupancy(docId);
      allow delete: if false;
    }

    // Everything else is denied by default.
  }
}
